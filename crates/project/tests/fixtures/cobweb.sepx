{
  "format": "separatrix",
  "format_version": 1,
  "min_reader_version": 1,
  "app_version": "0.2.0",
  "system": {
    "kind": "map",
    "input_format": "latex",
    "lines": [
      "x_{n+1}=rx_n\\left(1-x_n\\right)"
    ],
    "states": [
      "x"
    ],
    "params": [
      {
        "id": "r",
        "value": 3.5,
        "min": 0.0,
        "max": 4.0
      }
    ],
    "template": "logistic-map"
  },
  "initial_conditions": [
    {
      "id": "ic-1",
      "x0": [
        0.1
      ],
      "t0": 0.0,
      "color": 0,
      "hidden": false
    }
  ],
  "views": [
    {
      "id": "main",
      "kind": "cobweb",
      "x_axis": {
        "kind": "state",
        "name": "x"
      },
      "y_axis": {
        "kind": "next",
        "name": "x"
      },
      "x_range": [
        -0.05,
        1.05
      ],
      "y_range": [
        -0.05,
        1.05
      ],
      "slice": {
        "states": {},
        "t": 0.0
      },
      "layers": {
        "field": true,
        "field_grid": 21,
        "nullclines": true,
        "fixed_points": true,
        "backward": true
      }
    }
  ],
  "analyses": [],
  "solver": {
    "method": "dopri5",
    "rtol": 1e-6,
    "atol": 1e-9,
    "h": 0.0,
    "max_steps": 200000,
    "t_end": 60.0,
    "transient": 200,
    "samples": 0
  }
}
