{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Separatrix",
  "version": "0.2.0",
  "identifier": "io.github.uncrayon.separatrix",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Separatrix",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws://localhost:1420 ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Explore dynamical systems: phase portraits, chaos and bifurcations",
    "fileAssociations": [
      {
        "ext": ["sepx"],
        "name": "Separatrix project",
        "description": "Separatrix project",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-separatrix-project",
        "contentTypes": ["io.github.uncrayon.separatrix.project"],
        "exportedType": {
          "identifier": "io.github.uncrayon.separatrix.project",
          "conformsTo": ["public.json", "public.data"]
        }
      }
    ],
    "macOS": { "signingIdentity": "-" },
    "windows": { "nsis": { "installMode": "currentUser" } },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/separatrix.desktop.hbs",
        "files": {
          "/usr/share/mime/packages/io.github.uncrayon.separatrix.xml": "linux/separatrix-mime.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/separatrix.desktop.hbs",
        "files": {
          "/usr/share/mime/packages/io.github.uncrayon.separatrix.xml": "linux/separatrix-mime.xml"
        }
      }
    }
  }
}
