{
  "format": "separatrix",
  "format_version": 1.0,
  "min_reader_version": 1.0,
  "app_version": "0.2.0",
  "system": {
    "kind": "ode",
    "input_format": "text",
    "lines": ["x' = y", "y' = -x"],
    "params": []
  },
  "initial_conditions": [
    { "id": "ic-1", "x0": [1.0, 0.0], "t0": 0.0, "color": 3e0, "hidden": false }
  ],
  "views": [
    {
      "id": "main",
      "x_axis": { "kind": "state", "name": "x" },
      "y_axis": { "kind": "state", "name": "y" },
      "x_range": [-2.0, 2.0],
      "y_range": [-2.0, 2.0],
      "layers": { "field": true, "field_grid": 21.0, "nullclines": false, "fixed_points": true, "backward": false }
    }
  ],
  "analyses": [],
  "solver": { "method": "dopri5", "rtol": 1e-6, "atol": 1e-9, "h": 0.0, "max_steps": 1e5, "t_end": 10.0, "samples": 2000.0 }
}
